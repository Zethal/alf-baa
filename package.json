{
  "name": "alf-baa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ألف باء — a bilingual, host-led party trivia game",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
